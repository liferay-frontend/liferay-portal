		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column method-name="FVSEntryId" name="fvsEntryId" type="long" />
		<column method-name="FDSName" name="fdsName" type="String" />
		<column name="name" type="String" />
		<column name="plid" type="long" />
		<column name="portletId" type="String" />
		<column name="system" type="boolean" />

		<!-- Order -->

		<!-- Finder methods -->

		<finder name="F_S" return-type="Collection">
			<finder-column name="fdsName" />
			<finder-column name="system" />
		</finder>
		<finder name="U_F_P_P_S" return-type="Collection">
			<finder-column name="userId" />
			<finder-column name="fdsName" />
			<finder-column name="plid" />
			<finder-column name="portletId" />
			<finder-column name="system" />
		</finder>
	</entity>
	<exceptions>
	</exceptions>
