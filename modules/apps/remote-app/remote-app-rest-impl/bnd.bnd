Bundle-Name: Liferay Remote App REST Implementation
Bundle-SymbolicName: com.liferay.remote.app.rest.impl
Bundle-Version: 1.0.0
Import-Package:\
	!com.fasterxml.jackson.*,\
	\
	!com.google.gson.*,\
	\
	!org.apache.tapestry5.json.*,\
	\
	*
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.remote.app.rest.impl)";\
		resource.bundle.base.name="content.Language";\
		service.ranking:Long="1"
Web-ContextPath: /remote-app-rest-impl