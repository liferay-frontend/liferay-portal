{
	"frontend-js-translation-web": {
		"dest-mod-name-mapper": {
			"from": "(.*)\\.js$",
			"to": "bridge/frontend-js-translation-web/$1"
		},
		"file-globs": "**/*.js,!**/bridge",
		"input": "build/node/packageRunBuild/resources",
		"output": "build/node/packageRunBuild/resources/bridge/frontend-js-translation-web",
		"src-mod-name-mapper": {
			"from": "(.*)\\.js$",
			"to": "frontend-js-translation-web/$1"
		}
	}
}