@component-name = "portal-frontend-infrastructure"
definition {

	property custom.properties = "feature.flag.LPS-164563=true${line.separator}feature.flag.LPS-188645=true";
	property portal.acceptance = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Frontend Data Set";
	property testray.main.component.name = "Frontend Data Set";

	var pageName = "Data Set Test Page";

	setUp {
		var portalURL = PropsUtil.get("portal.url");

		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		JSONLayout.deletePublicLayout(
			groupName = "Guest",
			layoutName = ${pageName});

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DataSetAdmin.deleteAllDataSetEntries();
		}
	}

	@description = "LPS-191295. Confirm that after created a filter is displayed in the fragment and it is also possible to apply it. "
	@priority = 5
	test CanAppliedFilter {
		task ("Given a new Object entity") {
			ObjectAdmin.addObjectViaAPI(
				labelName = "Date Object",
				objectName = "DateObject",
				pluralLabelName = "Date Objects");

			ObjectAdmin.addObjectFieldViaAPI(
				fieldBusinessType = "Date",
				fieldLabelName = "Date Field",
				fieldName = "dateField",
				fieldType = "Date",
				isRequired = "false",
				objectName = "DateObject");

			ObjectAdmin.publishObjectViaAPI(objectName = "DateObject");
		}

		task ("And new entries in the new Object entity") {
			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "dateField",
				objectName = "DateObject",
				value = "2023-06-06");

			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "dateField",
				objectName = "DateObject",
				value = "2023-02-02");

			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "dateField",
				objectName = "DateObject",
				value = "2023-03-03");
		}

		task ("And creating a Data Set entry, view and fields") {
			DataSetAdmin.createAndConfigureDataSetEntry(
				dataSetName = "Custom Data Set Entry",
				dataSetViewDescription = "View Description",
				dataSetViewName = "Date filters view",
				key_fieldList = "dateField,id,dateCreated",
				restApplication = "/c/dateobjects",
				restEndpoint = "/",
				restSchema = "DateObject");
		}

		task ("and add date filter to view") {
			DataSetAdmin.goToTab(tabName = "Filters");

			DataSetAdmin.createDateFilter(
				fieldValueFrom = "2023-01-01",
				fieldValueTo = "2023-03-10",
				filterBy = "dateField",
				filterName = "Date Filter 1",
				valueDayFrom = 1,
				valueDayTo = 10,
				valueMonthFrom = "January",
				valueMonthTo = "March",
				valueYearFrom = 2023,
				valueYearTo = 2023);
		}

		task ("And adds the data set Fragment portlet in the page") {
			DataSetFragment.setUpDataSetPage(
				dataSetViewName = "Date filters view",
				pageName = ${pageName});
		}

		task ("Then Confirm that only data within the filter range is shown") {
			AssertElementPresent(
				key_labelName = "2023-02-02T00:00:00Z",
				key_rowPosition = 1,
				locator1 = "DataSet#VIEW_LABEL_POSITION");

			AssertElementPresent(
				key_labelName = "2023-03-03T00:00:00Z",
				key_rowPosition = 2,
				locator1 = "DataSet#VIEW_LABEL_POSITION");
		}
	}

	@description = "Blocked by LPS-198444 | LPS-191295. Confirm that after created a filter is displayed in the fragment and it is also possible to apply it. "
	@ignore = "true"
	@priority = 4
	test CanChangeFilters {

		// TODO LPS-191295 CanChangeFilters pending implementation

	}

	@description = "LPS-191295. It's possible to remove a filter from the fragment"
	@priority = 4
	test CanRemoveFilter {
		task ("Given a new Object entity") {
			ObjectAdmin.addObjectViaAPI(
				labelName = "Date Object",
				objectName = "DateObject",
				pluralLabelName = "Date Objects");

			ObjectAdmin.addObjectFieldViaAPI(
				fieldBusinessType = "Date",
				fieldLabelName = "Date Field",
				fieldName = "dateField",
				fieldType = "Date",
				isRequired = "false",
				objectName = "DateObject");

			ObjectAdmin.publishObjectViaAPI(objectName = "DateObject");
		}

		task ("And new entries in the new Object entity") {
			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "dateField",
				objectName = "DateObject",
				value = "2023-06-06");

			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "dateField",
				objectName = "DateObject",
				value = "2023-02-02");

			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "dateField",
				objectName = "DateObject",
				value = "2023-03-03");
		}

		task ("And creating a Data Set entry, view and fields") {
			DataSetAdmin.createAndConfigureDataSetEntry(
				dataSetName = "Custom Data Set Entry",
				dataSetViewDescription = "View Description",
				dataSetViewName = "Date filters view",
				key_fieldList = "dateField,id,dateCreated",
				restApplication = "/c/dateobjects",
				restEndpoint = "/",
				restSchema = "DateObject");
		}

		task ("and add date filter to view") {
			DataSetAdmin.goToTab(tabName = "Filters");

			DataSetAdmin.createDateFilter(
				fieldValueFrom = "2023-01-01",
				fieldValueTo = "2023-03-10",
				filterBy = "dateField",
				filterName = "Date Filter 1",
				valueDayFrom = 1,
				valueDayTo = 10,
				valueMonthFrom = "January",
				valueMonthTo = "March",
				valueYearFrom = 2023,
				valueYearTo = 2023);
		}

		task ("And adds the data set Fragment portlet in the page") {
			DataSetFragment.setUpDataSetPage(
				dataSetViewName = "Date filters view",
				pageName = ${pageName});
		}

		task ("And open the menu of filters") {
			FrontendDataSetFilters.removeFilter(key_filter = "Date Filter 1");
		}

		task ("Then Confirm that all fields are shown") {
			AssertElementPresent(
				key_labelName = "2023-06-06T00:00:00Z",
				key_rowPosition = 1,
				locator1 = "DataSet#VIEW_LABEL_POSITION");

			AssertElementPresent(
				key_labelName = "2023-02-02T00:00:00Z",
				key_rowPosition = 2,
				locator1 = "DataSet#VIEW_LABEL_POSITION");

			AssertElementPresent(
				key_labelName = "2023-03-03T00:00:00Z",
				key_rowPosition = 3,
				locator1 = "DataSet#VIEW_LABEL_POSITION");
		}
	}

	@description = "LPS-185995 check whether the filter in a picklist appears in the filter menu of a content page"
	@priority = 5
	test CheckDynamicFilterInFragmentWithMultiplePrePopulatedValuesAndExclude {
		task ("Given that the user added a Picklist") {
			Picklist.addPicklistViaAPI(picklistName = "Transport");

			Picklist.addPicklistItemViaAPI(
				itemKey = "bike",
				itemName = "bike",
				picklistName = "Transport");

			Picklist.addPicklistItemViaAPI(
				itemKey = "car",
				itemName = "car",
				picklistName = "Transport");

			Picklist.addPicklistItemViaAPI(
				itemKey = "bus",
				itemName = "bus",
				picklistName = "Transport");
		}

		task ("And the user creates an object") {
			ObjectAdmin.openObjectAdmin();

			ObjectAdmin.addObjectViaAPI(
				labelName = "Transport",
				objectName = "Transport",
				pluralLabelName = "Transport");

			Refresh();

			ACUtils.waitForScrollDown();

			Click(
				key_labelName = "Transport",
				locator1 = "CreateObject#OBJECT_NAME");

			Button.clickSave();

			ObjectAdmin.goToFieldsTab();

			Refresh();
		}

		task ("And Adding items to the created picklist") {
			LexiconEntry.gotoAdd();

			Type(
				locator1 = "ObjectField#LABEL_INPUT",
				value1 = "Filter");

			Click(
				key_sorting = "",
				locator1 = "ObjectCustomViews#EDIT_SORTING");

			Click(
				key_fieldType = "Picklist",
				locator1 = "ObjectField#TYPE_OPTION");

			Click(locator1 = "ObjectCustomViews#SELECT_AUTO_COMPLETE");

			Click(
				key_optionName = "Transport",
				locator1 = "ObjectAdmin#LAYOUT_ADD_FIELD_OPTION");

			Button.clickSave();

			ObjectCustomValidation.gotoTab(tabName = "Details");

			Button.clickPublish();
		}

		task ("When the user creates a new data set") {
			Navigator.openURL();

			DataSetAdmin.goToDataSetAdminPage();

			DataSetAdmin.createDataSetEntryViaAPI(
				dataSetName = "Dataset Test",
				restApplication = "/data-set-manager/fields",
				restEndpoint = "/",
				restSchema = "FDSField");
		}

		task ("And a data set view created via api") {
			DataSetAdmin.createFDSViewViaAPI(
				dataSetName = "Dataset Test",
				dataSetViewDescription = "FDSViewDescription",
				key_dataSetViewNameList = "View Fields Test");

			DataSetAdmin.goToSpecificViewPage(
				dataSetName = "Dataset Test",
				key_viewName = "View Fields Test");
		}

		task ("When the user creates a field guide and goes to it") {
			DataSetAdmin.goToTab(tabName = "Filters");

			LexiconEntry.gotoAdd();

			Click(
				key_fieldName = "Selection",
				locator1 = "FormViewBuilder#OBJECT_FIELD_BUTTON_DROPDOWN");

			Type(
				key_text = "Name",
				locator1 = "TextInput#ANY",
				value1 = "Bike");

			Click(
				key_class = "btn-secondary",
				key_index = 2,
				locator1 = "Button#ANY_WITH_CLASS_AND_INDEX");

			SelectFrameTop();

			Click.javaScriptClick(
				key_sortOption = "Relationship_c_fdsViewERC",
				locator1 = "ObjectCustomViews#SORT_OPTION");

			Select(
				locator1 = "DataSet#SOURCE_OPTIONS_SELECT",
				value1 = "Transport");
		}

		task ("And Preselected Values bike") {
			Click(
				key_fieldName = "Select a default value for your filter.",
				locator1 = "ObjectCustomViews#FROM_DATE_INPUT");

			Click(
				key_sortOption = "bike",
				locator1 = "ObjectCustomViews#SORT_OPTION");
		}

		task ("And Select the option Multiple,Include radio button") {
			Click.clickAtNotVisible(
				key_radioOption = "Multiple",
				locator1 = "CommerceEntry#RADIO_BUTTON");

			Click.clickAtNotVisible(
				key_radioOption = "Exclude",
				locator1 = "CommerceEntry#RADIO_BUTTON");

			Button.clickSave();
		}

		task ("When the user adds a widget page and add a fragment Data Set") {
			DataSetFragment.setUpDataSetPage(
				dataSetViewName = "Date filters view",
				pageName = "Test Page");
		}

		task ("Then confirm the display of Filters, the selection of Delete and the presence of pre-selected values.") {
			AssertElementPresent(locator1 = "FrontendDataSet#FILTER_DROPDOWN");
		}
	}

